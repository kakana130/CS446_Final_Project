{
  "name": "plate2home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --project db",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:coverage": "vitest run --project unit --coverage",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:provinces": "node scripts/gen-provinces-sql.mjs --check",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:contrast && npm run check:provinces && npm test",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:local": "node scripts/db-local.mjs",
    "gen:provinces": "node scripts/gen-provinces-sql.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "vitest run --project integration",
    "predev": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "copy:ocr": "node scripts/copy-ocr-assets.mjs",
    "admin:password": "node scripts/admin-password.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "3.1164.0",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@node-rs/argon2": "2.2.2",
    "jose": "6.2.16",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
