# Plate2Home on AWS — environment variables (copy to .env on the EC2 instance).
# NEXT_PUBLIC_* values are built into the pages: never put a secret in one, and rebuild
# (bash aws/ec2/update.sh) after changing them. Everything else is server-only.
# AWS credentials are NOT set here: the EC2 instance role (LabInstanceProfile) provides them.

# --- App -------------------------------------------------------------------------------
# The site's address, no trailing slash: the EC2 instance's Public IPv4 DNS over http, e.g.
# http://ec2-34-201-92-198.compute-1.amazonaws.com (http://localhost:3000 for local
# development). Used for the Origin check on forms and for links in alert emails.
APP_ORIGIN=http://localhost:3000

# --- Amazon RDS for PostgreSQL ---------------------------------------------------------
# postgresql://<user>:<password>@<rds-endpoint>:5432/<db name>
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F, : → %3A).
DATABASE_URL=postgresql://postgres:CHANGE_ME@plate2home-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/plate2home
# verify (RDS certificate, needs DATABASE_CA_FILE) | require (encrypted, not verified) | off
DATABASE_SSL=verify
# Downloaded by aws/ec2/setup.sh
DATABASE_CA_FILE=./rds-global-bundle.pem
DATABASE_POOL_MAX=10

# --- AWS -------------------------------------------------------------------------------
AWS_REGION=us-east-1
# Amazon S3 bucket for plate photos (private; Block Public Access on)
S3_BUCKET=plate2home-crops-CHANGE_ME
# AWS Lambda function that sends match alerts through Amazon SNS
NOTIFY_LAMBDA_NAME=plate2home-notify
# Show the "email me when someone finds this plate" checkbox (needs the Lambda + SNS topic).
NEXT_PUBLIC_FEATURE_ALERTS=true

# --- Amazon Cognito (optional sign-in, NOT used on the plain-http EC2 setup) -------------
# Cognito only signs in on https sites. Over plain http leave all of this empty and keep
# NEXT_PUBLIC_FEATURE_ACCOUNTS=false: the sign-in UI is hidden and posts belong to the device.
NEXT_PUBLIC_FEATURE_ACCOUNTS=false
COGNITO_USER_POOL_ID=
# The user pool's domain, e.g. https://plate2home-xyz.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
# Only if the app client has a secret ("Traditional web application" clients do).
COGNITO_CLIENT_SECRET=
# COGNITO = Cognito's own email + password accounts (simplest).
# Google   = "Continue with Google" (needs Google set up as an identity provider in Cognito).
COGNITO_IDENTITY_PROVIDER=COGNITO
# Signs the session cookie. >= 32 random chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=

# --- Cloudflare Turnstile (bot check on forms) -------------------------------------------
# Defaults are Cloudflare's public TEST keys (always pass). For real protection create a
# widget for your CloudFront hostname at dash.cloudflare.com and use its keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Secrets -----------------------------------------------------------------------------
# The daily cleanup Lambda sends `Authorization: Bearer $CRON_SECRET`. >= 32 random chars.
CRON_SECRET=
# Keys the HMAC used to hash IP addresses and SNS owner keys. >= 32 random chars.
IP_HASH_SECRET=

# Admin area (/admin). Generate both with: npm run admin:password
# ADMIN_PASSWORD_HASH is an argon2id hash (never the password itself).
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
CRON_ENABLED=true

# --- Access log. LEGAL-TODO(access-log): keep disabled until legal advice -----------------
ACCESS_LOG_ENABLED=false
ACCESS_LOG_KEY=
ACCESS_LOG_KEY_VERSION=1
ACCESS_LOG_RETENTION_DAYS=90

# --- Feature flags -----------------------------------------------------------------------
# In-browser plate finding/reading. On unless set to false. Manual entry always works.
NEXT_PUBLIC_FEATURE_OCR=true

# --- Web Push (not used yet) ---------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
